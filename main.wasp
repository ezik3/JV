route POSInventoryRoute {
  path: "/venue/pos/inventory",
  to: POSInventoryPage
}

page POSInventoryPage {
  component: import POSInventory from "@src/frontend/pages/POS/components/POSInventory"
}

route POSMenuBuilderRoute {
  path: "/venue/pos/menu",
  to: POSMenuBuilderPage
}

page POSMenuBuilderPage {
  component: import POSMenuBuilder from "@src/frontend/pages/POS/components/POSMenuBuilder"
}

route VenueMessagesRoute {
  path: "/venue/messages",
  to: VenueMessagesPage
}

route VenueNotificationsRoute {
  path: "/venue/notifications",
  to: VenueNotificationsPage
}

route VenueSettingsRoute {
  path: "/venue/settings",
  to: VenueSettingsPage
}

page VenueMessagesPage {
  component: import VenueMessages from "@src/frontend/pages/VenueMessages"
}

page VenueNotificationsPage {
  component: import VenueNotifications from "@src/frontend/pages/VenueNotifications"
}

page VenueSettingsPage {
  component: import VenueSettings from "@src/frontend/pages/VenueSettings"
}

// ONLY KEEP THESE - NO ENTITY DECLARATIONS
action createMenuItem {
  fn: import { createMenuItem } from "@src/actions.js"
}

action updateMenuItem {
  fn: import { updateMenuItem } from "@src/actions.js"
}

action deleteMenuItem {
  fn: import { deleteMenuItem } from "@src/actions.js"
}

action updateInventory {
  fn: import { updateInventory } from "@src/actions.js"
}

query getMenuItems {
  fn: import { getMenuItems } from "@src/queries.js"
}

query getInventory {
  fn: import { getInventory } from "@src/queries.js"
}


// Add this to your routes section
page WalletPage {
  component: import WalletPage from "@src/frontend/pages/Wallet/WalletPage.jsx"
}

route WalletRoute { path: "/wallet", to: WalletPage }
