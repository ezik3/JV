# =====================================================
# JOINTVIBE POS V2 - ENVIRONMENT VARIABLES
# =====================================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit .env to git
# =====================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
VITE_APP_NAME=JointVibe POS
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_PUSH_ADS=true
VITE_ENABLE_CHECK_IN=true
VITE_ENABLE_REMOTE_ORDERING=true

# Geolocation
VITE_CHECK_IN_RADIUS=100  # meters

# OpenAI (for AI Waiter)
VITE_OPENAI_API_KEY=your-openai-key-here

# Stripe (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-key-here

# Optional: External Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key-here
VITE_TWILIO_ACCOUNT_SID=your-twilio-sid-here
