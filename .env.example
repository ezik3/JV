# ============================================================================
# JointVibe POS V2 - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Get these from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------------------------
# APP CONFIGURATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# PAYMENT PROCESSING (Optional - for future implementation)
# ----------------------------------------------------------------------------
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Square (Alternative)
SQUARE_APPLICATION_ID=your_square_app_id
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_square_location_id

# ----------------------------------------------------------------------------
# NOTIFICATIONS (Optional)
# ----------------------------------------------------------------------------
# Twilio for SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid for Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ----------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (Optional)
# ----------------------------------------------------------------------------
# QuickBooks
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret

# DoorDash/UberEats Integration
DOORDASH_API_KEY=your_doordash_api_key
UBEREATS_API_KEY=your_ubereats_api_key

# ----------------------------------------------------------------------------
# HARDWARE CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Receipt Printer
RECEIPT_PRINTER_IP=192.168.1.100
RECEIPT_PRINTER_PORT=9100

# Kitchen Printer
KITCHEN_PRINTER_IP=192.168.1.101
KITCHEN_PRINTER_PORT=9100

# Cash Drawer
CASH_DRAWER_TYPE=star_micronics
CASH_DRAWER_CONNECTION=usb

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# JWT Secret (for additional auth if needed)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Encryption Key (for sensitive data)
ENCRYPTION_KEY=your-encryption-key-32-characters-min

# ----------------------------------------------------------------------------
# DEVELOPMENT/DEBUGGING
# ----------------------------------------------------------------------------
# Enable debug logging
DEBUG=false
LOG_LEVEL=info

# Enable Supabase local development
SUPABASE_LOCAL_URL=http://localhost:54321
SUPABASE_LOCAL_ANON_KEY=your-local-anon-key

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 1. SUPABASE_URL and SUPABASE_ANON_KEY are REQUIRED
# 2. All other variables are optional depending on features you use
# 3. Payment integration requires either Stripe or Square keys
# 4. Notification features require Twilio and/or SendGrid
# 5. Hardware integration is optional for cloud-only deployments
# ============================================================================
